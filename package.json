{
  "name": "modern-eq",
  "version": "1.1.1",
  "description": "A Spicetify extension that replaces Spotify's stock equalizer with a modern multi-band EQ panel with regions, presets, and live curve visualization.",
  "main": "dist/modern-eq.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/7xeh/SpotifyModernEQ.git"
  },
  "bugs": {
    "url": "https://github.com/7xeh/SpotifyModernEQ/issues"
  },
  "homepage": "https://github.com/7xeh/SpotifyModernEQ#readme",
  "scripts": {
    "build": "node build.js",
    "build:watch": "node build.js --watch",
    "deploy": "node deploy.js",
    "apply": "spicetify apply",
    "release": "node build.js --no-bump",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "keywords": [
    "spicetify",
    "spotify",
    "equalizer",
    "eq",
    "audio",
    "extension"
  ],
  "author": "7xeh",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}
